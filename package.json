		"@oh-my-pi/omptype": "18.2.11"
	},
	"devDependencies": {
		"@oh-my-pi/pi-agent-core": "18.2.11",
		"@oh-my-pi/pi-ai": "18.2.11",
		"@oh-my-pi/pi-coding-agent": "18.2.11",
		"@oh-my-pi/pi-tui": "18.2.11",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"@oh-my-pi/pi-utils": "18.2.11",
		"@oh-my-pi/omptype": "18.2.11",
		"@oh-my-pi/pi-catalog": "18.2.11",
		"vitest": "4.1.9"
	},
	"engines": {
