{
	"name": "sol-omp",
	"version": "0.1.0",
	"description": "OMP-native context and tool-efficiency extensions",
	"type": "module",
	"private": true,
	"files": [
		"src/sol-omp",
		"docs/compatibility.md",
		"docs/configuration.md",
		"scripts/check-sol-omp-config.mjs",
		"scripts/check-omp-compat.mjs",
		"agents-install.md",
		"README.md",
		"LICENSE",
